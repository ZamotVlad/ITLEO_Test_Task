msgid "Cron Minutes to Run. Use \"*\" for \"all\". (Example: \"0,30\")"
msgstr "Хвилини для Cron. Використовуйте \"*\" для \"усіх\". (Наприклад: \"0,30\")"

msgid "Hour(s)"
msgstr "Година(и)"

msgid "Cron Hours to Run. Use \"*\" for \"all\". (Example: \"8,20\")"
msgstr "Години для Cron. Використовуйте \"*\" для \"усіх\". (Наприклад: \"8,20\")"

msgid "Day(s) Of The Month"
msgstr "День(і) місяця"

msgid "Cron Days Of The Month to Run. Use \"*\" for \"all\". (Example: \"1,15\")"
msgstr "Дні місяця для Cron. Використовуйте \"*\" для \"усіх\". (Наприклад: \"1,15\")"

msgid "Month(s) Of The Year"
msgstr "Місяць(і) року"

msgid "Cron Months (1-12) Of The Year to Run. Use \"*\" for \"all\". (Example: \"1,12\")"
msgstr ""
"Місяці (1-12) року для Cron. Використовуйте \"*\" для \"усіх\". (Наприклад: "
"\"1,12\")"

msgid "Day(s) Of The Week"
msgstr "День(і) тижня"

msgid ""
"Cron Days Of The Week to Run. Use \"*\" for \"all\", Sunday is 0 or 7, "
"Monday is 1. (Example: \"0,5\")"
msgstr ""
"Дні тижня для Cron. Використовуйте \"*\" для \"усіх\", неділя — 0 або 7, "
"понеділок — 1. (Наприклад: \"0,5\")"

msgid "Cron Timezone"
msgstr "Часовий пояс Cron"

msgid "Timezone to Run the Cron Schedule on. Default is UTC."
msgstr "Часовий пояс для розкладу Cron. За замовчуванням UTC."

